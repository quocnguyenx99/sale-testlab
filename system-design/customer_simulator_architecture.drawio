="r9" target="r10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="re10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff" edge="1" parent="1" source="r10" target="r11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="re11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff" edge="1" parent="1" source="r11" target="r12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="re12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff" edge="1" parent="1" source="r12" target="r13"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="re13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff" edge="1" parent="1" source="r13" target="r14"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="re14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff" edge="1" parent="1" source="r14" target="r15"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="err_lane" value="ERROR / CANCEL PATHS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1f2;strokeColor=#e11d48;fontColor=#0f172a;align=left;verticalAlign=top;spacing=8;fontSize=14;fontStyle=1;fontSize=18;spacingTop=10;spacingLeft=12" vertex="1" parent="1"><mxGeometry x="70" y="740" width="1740" height="300" as="geometry" /></mxCell><mxCell id="timeout" value="&lt;b&gt;AI timeout / provider unavailable&lt;/b&gt;&lt;br&gt;Abort request → choose deterministic fallback when allowed&lt;br&gt;otherwise mark FAILED with stable error code" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe4e6;strokeColor=#e11d48;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=8;fontSize=14" vertex="1" parent="1"><mxGeometry x="110" y="810" width="470" height="120" as="geometry" /></mxCell><mxCell id="disconnect" value="&lt;b&gt;Client disconnect / Stop generation&lt;/b&gt;&lt;br&gt;AbortController → mark CANCELLED&lt;br&gt;persist partial diagnostics, never duplicate retry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe4e6;strokeColor=#e11d48;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=8;fontSize=14" vertex="1" parent="1"><mxGeometry x="690" y="810" width="470" height="120" as="geometry" /></mxCell><mxCell id="guard_block" value="&lt;b&gt;Guard cannot repair response&lt;/b&gt;&lt;br&gt;Use Response Bank / terminal reply&lt;br&gt;store raw output privately for diagnostics only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe4e6;strokeColor=#e11d48;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=8;fontSize=14" vertex="1" parent="1"><mxGeometry x="1270" y="810" width="470" height="120" as="geometry" /></mxCell><mxCell id="er1" value="timeout/error" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#e11d48;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;dashed=1" edge="1" parent="1" source="r7" target="timeout"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="er2" value="abort/disconnect" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#e11d48;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;dashed=1" edge="1" parent="1" source="r12" target="disconnect"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="er3" value="blocked" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#e11d48;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;dashed=1" edge="1" parent="1" source="r9" target="guard_block"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="runtime_note" value="&lt;b&gt;Why this differs from the original plan:&lt;/b&gt; once a raw token is sent over SSE, a later guard cannot take it back. The MVP should buffer the model result, run all guards, then stream only the approved final text in chunks." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#f97316;fontColor=#7c2d12;align=left;verticalAlign=middle;spacing=8;fontSize=14;dashed=1;fontSize=13" vertex="1" parent="1"><mxGeometry x="120" y="1080" width="1620" height="75" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="database" name="03 - Database Domains"><mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title3" value="&lt;b&gt;DATABASE DOMAIN MAP — RECOMMENDED v2.1&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;Operational MySQL; raw pipeline data remains outside DB&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#334155;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=8;fontSize=14;fontSize=20" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1800" height="65" as="geometry" /></mxCell><mxCell id="db_identity_lane" value="IDENTITY &amp; GOVERNANCE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontColor=#0f172a;align=left;verticalAlign=top;spacing=8;fontSize=14;fontStyle=1;fontSize=18;spacingTop=10;spacingLeft=12" vertex="1" parent="1"><mxGeometry x="50" y="115" width="350" height="310" as="geometry" /></m