. Route state + identity + build prompt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#86efac;strokeColor=#15803d;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=8;fontSize=14" vertex="1" parent="1"><mxGeometry x="1480" y="300" width="330" height="100" as="geometry" /></mxCell><mxCell id="r7" value="7. AI Provider request&#10;AbortController + timeout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=8;fontSize=14" vertex="1" parent="1"><mxGeometry x="1120" y="300" width="300" height="100" as="geometry" /></mxCell><mxCell id="r8" value="8. Buffer raw model output&#10;DO NOT emit to client" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=8;fontSize=14" vertex="1" parent="1"><mxGeometry x="760" y="300" width="300" height="100" as="geometry" /></mxCell><mxCell id="r9" value="9. Guard pipeline&#10;repeat → voice → completion → identity → safety → deal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=8;fontSize=14" vertex="1" parent="1"><mxGeometry x="400" y="300" width="300" height="145" as="geometry" /></mxCell><mxCell id="r10" value="10. Select final response&#10;AI / rewritten / fallback / terminal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce7f3;strokeColor=#db2777;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=8;fontSize=14" vertex="1" parent="1"><mxGeometry x="70" y="300" width="270" height="145" as="geometry" /></mxCell><mxCell id="r11" value="11. Persist atomically&#10;turn + session states + usage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#ea580c;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=8;fontSize=14" vertex="1" parent="1"><mxGeometry x="70" y="535" width="270" height="110" as="geometry" /></mxCell><mxCell id="r12" value="12. Emit guarded SSE&#10;start → state → delta → usage → done" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=8;fontSize=14" vertex="1" parent="1"><mxGeometry x="400" y="535" width="300" height="110" as="geometry" /></mxCell><mxCell id="r13" value="13. FE renders final response&#10;and unlocks input" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=8;fontSize=14" vertex="1" parent="1"><mxGeometry x="760" y="535" width="300" height="110" as="geometry" /></mxCell><mxCell id="r14" value="14. Optional evaluator&#10;score rubric + deal outcome" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=8;fontSize=14" vertex="1" parent="1"><mxGeometry x="1120" y="535" width="300" height="110" as="geometry" /></mxCell><mxCell id="r15" value="15. Feedback / analytics / replay" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=8;fontSize=14" vertex="1" parent="1"><mxGeometry x="1480" y="535" width="330" height="110" as="geometry" /></mxCell><mxCell id="re1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff" edge="1" parent="1" source="r1" target="r2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="re2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff" edge="1" parent="1" source="r2" target="r3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="re3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogon