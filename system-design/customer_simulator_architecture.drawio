hogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff" edge="1" parent="1" source="turns" target="feedback"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="dbe23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff" edge="1" parent="1" source="sessions" target="evaluations"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="dbe24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff" edge="1" parent="1" source="prompts" target="evaluations"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="dbe25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff" edge="1" parent="1" source="models" target="evaluations"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="db_note" value="&lt;b&gt;Core correction:&lt;/b&gt; the original Prisma section says “12 tables” but defines 13 models. This proposal intentionally expands to 18 operational tables by adding Users/RBAC, normalized Products, Evaluations and Import Jobs." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#f97316;fontColor=#7c2d12;align=left;verticalAlign=middle;spacing=8;fontSize=14;dashed=1;fontSize=13" vertex="1" parent="1"><mxGeometry x="70" y="1100" width="1710" height="65" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="roadmap" name="04 - Delivery Roadmap"><mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1050" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title4" value="&lt;b&gt;REVISED DELIVERY ROADMAP — BUILD A VERTICAL SLICE EARLY&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;DB-first is valid, but avoid building all UI before proving one end-to-end chat flow&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#334155;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=8;fontSize=14;fontSize=20" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1800" height="65" as="geometry" /></mxCell><mxCell id="p0" value="&lt;b&gt;Phase 0&#10;Baseline &amp; Runtime Safety Net&lt;/b&gt;&lt;br&gt;&lt;br&gt;TS config · UTF-8 audit&#10;freeze baseline tests&#10;patch proven defects" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontColor=#0f172a;align=left;verticalAlign=top;spacing=8;fontSize=14" vertex="1" parent="1"><mxGeometry x="70" y="150" width="230" height="205" as="geometry" /></mxCell><mxCell id="p1" value="&lt;b&gt;Phase 1&#10;Monorepo &amp; Infrastructure&lt;/b&gt;&lt;br&gt;&lt;br&gt;workspaces · contracts&#10;Docker MySQL/phpMyAdmin&#10;backend skeleton" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#ea580c;fontColor=#0f172a;align=left;verticalAlign=top;spacing=8;fontSize=14" vertex="1" parent="1"><mxGeometry x="340" y="150" width="230" height="205" as="geometry" /></mxCell><mxCell id="p2" value="&lt;b&gt;Phase 2&#10;DB &amp; Core Admin API&lt;/b&gt;&lt;br&gt;&lt;br&gt;migration · seed&#10;users/RBAC · personas&#10;scenarios · products · imports" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#0f172a;align=left;verticalAlign=top;spacing=8;fontSize=14" vertex="1" parent="1"><mxGeometry x="610" y="150" width="230" height="205" as="geometry" /></mxCell><mxCell id="p3" value="&lt;b&gt;Phase 3&#10;Thin Vertical Slice&lt;/b&gt;&lt;br&gt;&lt;br&gt;select persona → create session&#10;1 non-stream message → log&#10;prove DB/API/LLM contract" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#0f172a;align=left;verticalAlign=top;spacing=8;fontSize=14" vertex="1" parent="1"><mxGeometry x="880" y="150" width="230" height="205" as="geometry" /></mxCell><mxCell id="p4" value="&lt;b&gt;Phase 4&#10;Runtime Integration&lt;/b&gt;&lt;br&gt;&lt;br&gt;extract runtime-core&#10;provider abstraction&#10;guard-first SSE · cancel/fallback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#86efac;strokeColor=#15803d;fontColor=#0f172a;align=left;verticalAlign=top;spacing=8;fontSize=14" vertex="1" parent="1"><mxGeometry x="1150" y="150" width="230" height="205" as="geometry" /></mxCell><mxCell id="p5" value="&lt;b&gt;Phase 5&#10;Admin UI&lt;/b&gt;&lt;br&gt;&lt;br&gt;CRUD screens&#10;imports · health · logs&#10;start analytics basics" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0e7ff;strokeColor=#4f46e5;fontColor=#0f172a;align=left;verticalAlign=top;spacing=8;fontSize=14" vertex="1" parent="1"><mxGeometry x="1420" y="150" width="230" height="205" as="geometry" /></mxCell><mxCell id="p6" value="&lt;b&gt;Phase 6&#10;Simulator UI&lt;/b&gt;&lt;br&gt;&lt;br&gt;setup · chat · debug&#10;results · feedback&#10;reconnect/idempotency" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#0f172a;align=left;verticalAlign=top;spacing=8;fontSize=14" vertex="1" parent="1"><mxGeometry x="70" y="500" width="230" height="205" as="geometry" /></mxCell><mxCell id="p7" value="&lt;b&gt;Phase 7&#10;Evaluation &amp; Analytics&lt;/b&gt;&lt;br&gt;&lt;br&gt;rubrics · evaluator&#10;latency/error/feedback&#10;replay and comparison" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;fontColor=#0f172a;align=left;verticalAlign=top;spacing=8;fontSize=14" vertex="1" parent="1"><mxGeometry x="430" y="500" width="230" height="205" as="geometry" /></mxCell><mxCell id="p8" value="&lt;b&gt;Phase 8&#10;E2E, Privacy &amp; Operations&lt;/b&gt;&lt;br&gt;&lt;br&gt;security gates · retention&#10;backup/restore · load test&#10;runbook · graceful shutdown" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#0f172a;align=left;verticalAlign=top;spacing=8;fontSize=14" vertex="1" parent="1"><mxGeometry x="790" y="500" width="230" height="205" as="geometry" /></mxCell><mxCell id="pe1" value="gate pass" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff" edge="1" parent="1" source="p0" target="p1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="pe2" value="gate pass" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="pe3" value="gate pass" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff" edge="1" parent="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="pe4" value="gate pass" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff" edge="1" parent="1" source="p3" target="p4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="pe5" value="gate pass" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff" edge="1" parent="1" source="p4" target="p5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="pe6" value="gate pass" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff" edge="1" parent="1" source="p5" target="p6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="pe7" value="gate pass" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff" edge="1" parent="1" source="p6" target="p7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="pe8" value="gate pass" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff" edge="1" parent="1" source="p7" target="p8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="road_note1" value="&lt;b&gt;Why the order changes:&lt;/b&gt; a thin vertical slice in Phase 3 exposes API, snapshot, persistence and Local AI integration risks before the team spends heavily on complete Admin/Simulator screens." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;fontColor=#7c2d12;align=left;verticalAlign=middle;spacing=8;fontSize=14;dashed=1;fontSize=13" vertex="1" parent="1"><mxGeometry x="70" y="800" width="820" height="90" as="geometry" /></mxCell><mxCell id="road_note2" value="&lt;b&gt;UI strategy:&lt;/b&gt; build route skeletons and shared components early, but finish each screen only after its API contract and service behavior are stable." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;fontColor=#7c2d12;align=left;verticalAlign=middle;spacing=8;fontSize=14;dashed=1;fontSize=13" vertex="1" parent="1"><mxGeometry x="950" y="800" width="820" height="90" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>