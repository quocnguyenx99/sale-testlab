OPENAI_BASE_URL=http://192.168.117.73:9001/v1
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=qwen3-8b
OPENAI_MAX_TOKENS=512
OPENAI_DISABLE_THINKING=true
ENABLE_MODEL_INSTRUMENTATION=true
MODEL_INSTRUMENTATION_LOG_PATH=logs/qwen3_instrumentation_log.jsonl

# MySQL connection used by Prisma and the backend.
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/sale_testlab"

# Required only when running the explicit DEV_BOOTSTRAP_ONLY seed command.
DEV_BOOTSTRAP_EMAIL=""
DEV_BOOTSTRAP_PASSWORD=""
DEV_BOOTSTRAP_DISPLAY_NAME=""

# Optional backend settings.
AUTH_SESSION_TTL_HOURS="168"
PLAYGROUND_PORT="3009"
